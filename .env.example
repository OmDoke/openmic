# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your api key"

# Speech Recognition Configuration
# Choose one provider: azure, whisper, groq, or deepgram
SPEECH_PROVIDER=deepgram


# Optional: Groq Speech Configuration
GROQ_SPEECH_KEY="your api key"
GROQ_SPEECH_MODEL=whisper-large-v3


# Optional: Deepgram cloud speech configuration. Groq is used as a fallback
# when Deepgram is selected and its request fails.
DEEPGRAM_SPEECH_KEY="your api key"
DEEPGRAM_SPEECH_MODEL=nova-3

# Optional: Azure Speech Services Configuration

CAPTURE_SOURCE=system_audio

# Performance: only log warnings and errors (reduces SSD writes on low-spec hardware)
LOG_LEVEL=warn
# Dynamically selected Gemini Model
GEMINI_MODEL=gemini-3.5-flash
